<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F1"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Judul -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profil Saya"
            android:textColor="#3E2B2F"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- Foto Profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="55sp"
                android:background="#FCE8DA" />

            <TextView
                android:id="@+id/tvNamaProfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Pengguna Ekrafku"
                android:textColor="#3E2B2F"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pecinta karya kreatif lokal"
                android:textColor="#8D6E63"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Informasi Akun -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Informasi Akun"
                    android:textColor="#3E2B2F"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Lengkap"
                    android:textColor="#8D6E63"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNamaLengkap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pengguna Ekrafku"
                    android:textColor="#3E2B2F"
                    android:textSize="15sp"
                    android:layout_marginTop="5dp"
                    android:paddingBottom="14dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EADBD0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#8D6E63"
                    android:textSize="12sp"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/tvEmailProfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum tersedia"
                    android:textColor="#3E2B2F"
                    android:textSize="15sp"
                    android:layout_marginTop="5dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pengaturan -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnPengaturan"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="22dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    app:srcCompat="@drawable/ic_settings"
                    app:tint="#8D6E63"
                    android:contentDescription="Pengaturan" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pengaturan"
                    android:textColor="#3E2B2F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8D6E63"
                    android:textSize="28sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Keluar -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnKeluarProfil"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    app:srcCompat="@drawable/ic_logout"
                    app:tint="#D84343"
                    android:contentDescription="Keluar" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Keluar"
                    android:textColor="#D84343"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8D6E63"
                    android:textSize="28sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
