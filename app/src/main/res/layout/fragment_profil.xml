<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profil Saya"
            android:textColor="#4E342E"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:layout_marginTop="20dp"
            android:background="#F8E4D4">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="Foto profil pengguna"
                android:tint="#C94E12"
                android:padding="12dp" />

            <TextView
                android:id="@+id/tvNamaProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pengguna Ekrafku"
                android:textColor="#4E342E"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pecinta karya kreatif lokal"
                android:textColor="#8D6E63"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informasi Akun"
            android:textColor="#4E342E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama lengkap"
            android:textColor="#8D6E63"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvNamaLengkap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengguna Ekrafku"
            android:textColor="#4E342E"
            android:textSize="16sp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8D7CA" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#8D6E63"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvEmailProfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum tersedia"
            android:textColor="#4E342E"
            android:textSize="16sp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8D7CA" />

    </LinearLayout>
</ScrollView>
