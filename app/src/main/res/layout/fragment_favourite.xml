<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F1"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Karya Favorit"
        android:textColor="#3E2B2F"
        android:textSize="23sp"
        android:textStyle="bold"
        android:fontFamily="@font/fraunces" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kumpulan karya yang kamu sukai"
        android:textColor="#8D6E63"
        android:textSize="12sp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavorit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/tvFavoritKosong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Belum ada karya favorit.\nYuk, jelajahi karya lokal!"
        android:textColor="#8D6E63"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

</LinearLayout>
