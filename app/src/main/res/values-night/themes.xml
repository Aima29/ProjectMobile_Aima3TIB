<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Force Light Theme even in Night Mode to prevent black screens -->
    <style name="Base.Theme.ProjectMobile_Aima3TIB" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#FFF5E8</item>
        <item name="android:colorBackground">#FFF5E8</item>
        <item name="android:navigationBarColor">#FFF5E8</item>
        <item name="android:statusBarColor">#FFF5E8</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.App.SplashScreen" parent="Base.Theme.ProjectMobile_Aima3TIB">
        <item name="android:windowBackground">#FFF5E8</item>
        <item name="android:colorBackground">#FFF5E8</item>
        <item name="android:navigationBarColor">#FFF5E8</item>
        <item name="android:statusBarColor">#FFF5E8</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
